+import { linkedPrimaryAnchors, hasPrimaryQueryMatch } from './wiki-source-association.js';
+const path = 'raw/transcripts/ticket-1.md';
+const error = 'ValueError: Expected singleton: stock.move()';
+const fn = '_tw_purchase_original_currency_unit_price';
+const content = `# 调查\n\n- [历史票](${path})：原文包含\`${error}\`和\`${fn}\`，尚未解决。`;
+describe('linked primary evidence anchors', () => {
+  it('links only source-verified code anchors in the cited body paragraph', () => {
+    expect(linkedPrimaryAnchors(content, path, `${error}\n${fn}`, '供应商账单确认失败')).toEqual([error, fn]);
+    expect(linkedPrimaryAnchors(content, path, '只有业务说明', '供应商账单确认失败')).toEqual([]);
+  });
+  it('rejects metadata-only, other paragraphs and unselected paths', () => {
+    expect(linkedPrimaryAnchors(`---\nsummary: \`${error}\`\nsources: [${path}]\n---\n# 正文`, path, error, '账单失败')).toEqual([]);
+    expect(linkedPrimaryAnchors(`\`${error}\`\n\n[票](${path})`, path, error, '账单失败')).toEqual([]);
+    expect(linkedPrimaryAnchors(content, 'raw/transcripts/other.md', error, '账单失败')).toEqual([]);
+  });
+  it('does not replace an explicit conflicting question error with a page error', () => {
+    expect(linkedPrimaryAnchors(content, path, `${error}\n${fn}`, 'AccessError 确认账单失败')).toEqual([]);
+  });
+  it('does not count query terms only present in a sender header as body hits', () => {
+    expect(hasPrimaryQueryMatch('- **[2026-10-21] HEADER_ONLY**(text): 无关说明', ['header_only'])).toBe(false);
+    expect(hasPrimaryQueryMatch('- **[2026-10-21] 用户**(text): HEADER_ONLY', ['header_only'])).toBe(true);
+  });
+});

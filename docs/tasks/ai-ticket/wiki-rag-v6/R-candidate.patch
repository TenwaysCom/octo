+import { createWikiRelevanceEvaluator, type RelevancePage } from './wiki-relevance.js';
+const p = (body: string, searchTerms: string[] = []): RelevancePage => ({ path: 'concepts/test.md', title: '历史资料', body, searchTerms });
+const evaluator = (page: RelevancePage) => createWikiRelevanceEvaluator([page, ...Array.from({ length: 99 }, (_, i) => ({ path: `concepts/${i}.md`, title: '常见资料', body: 'order bill quantity 数量 订单 重复 没有 approval', searchTerms: [] }))]);
+describe('wiki primary-question relevance', () => {
+  it('rejects generic and connecting terms even when expansions mention a different intent', () => {
+    const page = p('出库单Demand与Quantity建议', ['order', 'but']);
+    const r = evaluator(page);
+    expect(r.assess('order but', page).eligible).toBe(false);
+    expect(r.assess('创建预订单默认仓库', page).eligible).toBe(false);
+  });
+  it('accepts complete business phrases and exact functions without depending on generic confirm tokens', () => {
+    const page = p('采购路径 _tw_purchase_original_currency_unit_price', ['confirm vendor bill', '供应商账单确认失败']);
+    const r = evaluator(page);
+    expect(r.assess('confirm vendor bill', page).reason).toBe('whole_business_phrase');
+    expect(r.assess('供应商账单确认失败', page).eligible).toBe(true);
+    expect(r.assess('_tw_purchase_original_currency_unit_price', page).eligible).toBe(true);
+  });
+  it('needs two independent clues including a distinctive clue for partial matches', () => {
+    const page = p('English German order');const r = evaluator(page);
+    expect(r.assess('English order', page).eligible).toBe(true);
+    expect(r.assess('English', page).eligible).toBe(false);
+  });
+  it('does not count overlapping Chinese bigrams as independent clues', () => {
+    const page = p('购物车');expect(evaluator(page).assess('购物车', page).eligible).toBe(false);
+  });
+  it('rejects a conflicting error class even when the object or function overlaps', () => {
+    const page = p('ValueError: Expected singleton: stock.move() _tw_purchase_original_currency_unit_price');
+    expect(evaluator(page).assess('AccessError _tw_purchase_original_currency_unit_price', page).eligible).toBe(false);
+  });
+});
+
+it('accepts a literal named object plus two title clues without admitting another object from expansions', () => {
+  const page = { ...p('历史记录'), title: '重复订单的历史调查', objects: ['StoreBridge'] };
+  const r = evaluator(page);
+  expect(r.assess('StoreBridge订单重复', page).eligible).toBe(true);
+  expect(r.assess('AnotherStore订单重复', page).eligible).toBe(false);
+});
+
+it('honors a bilingual primary object constraint despite a rare but generic quantity token', () => {
+  const page = { ...p('Quantity 仓库数量'), title: 'Demand Quantity 与仓库' };
+  expect(evaluator(page).assess('Pre-orders（预售订单）默认仓库和 quantity', page).reason).toBe('explicit_object_mismatch');
+});

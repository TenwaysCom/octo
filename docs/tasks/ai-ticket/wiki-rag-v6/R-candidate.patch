@@ -0,0 +1,75 @@
+import { wikiErrorSignatures, wikiQueryTerms } from './wiki-evidence.js';
+
+export interface RelevancePage { path: string; title: string; body: string; summary?: string; metadata?: string; objects?: string[]; environments?: string[]; searchTerms: string[] }
+export interface RelevanceDecision { eligible: boolean; reason: string; anchors: string[] }
+const normalize = (value: string) => value.normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}_]+/gu, ' ').replace(/\s+/g, ' ').trim();
+const glue = new Set('but then into through there here than all same instead because so such each every either both been yet just'.split(' '));
+const effective = (text: string) => wikiQueryTerms(text.replace(/([A-Za-z])(\d)/g, '$1 $2'))
+  .filter((t) => !glue.has(t) && !/^reference$/i.test(t))
+  .map((t) => /^[a-z]{5,}s$/.test(t) && !t.endsWith('ss') ? t.slice(0, -1) : t);
+const phraseHasContent = (phrase: string) => /[\u3400-\u9fff]{4,}/.test(phrase) || new Set(effective(phrase).filter((t) => /^[a-z_]/i.test(t))).size >= 2;
+const technicalAnchors = (text: string) => [...new Set([
+  ...(text.match(/\b(?:[A-Za-z]\w*(?:Error|Exception):\s*)?Expected singleton:\s*[\w.]+\(\)/g) ?? []),
+  ...(text.match(/\b_?[A-Za-z]\w*_[A-Za-z][\w.]*/g) ?? []).filter((a) => !/^(?:rpc_error|uncaughtpromise_error)$/i.test(a)),
+])];
+
+// Primary question establishes relevance. Expansions never establish it alone.
+// The whole corpus is local to a reader run; no cross-workspace global state.
+export function createWikiRelevanceEvaluator(pages: RelevancePage[]) {
+  const dfs = new Map<string, number>();
+  for (const page of pages) for (const term of new Set(effective(page.title + '\n' + page.body))) dfs.set(term, (dfs.get(term) ?? 0) + 1);
+  const rareMax = pages.length * 0.05;
+  const nonoverlapping = (terms: string[], question: string) => {
+    const words = terms.filter((t) => /^[a-z_0-9]/i.test(t));
+    const cn = terms.filter((t) => !/^[a-z_0-9]/i.test(t)).map((term) => ({ term, start: question.toLowerCase().indexOf(term) }))
+      .filter((t) => t.start >= 0).sort((a, b) => a.start - b.start || b.term.length - a.term.length);
+    let end = -1;
+    for (const item of cn) if (item.start >= end) { words.push(item.term); end = item.start + item.term.length; }
+    return words;
+  };
+  const assess = (question: string, page: RelevancePage): RelevanceDecision => {
+    const text = [page.title, page.body, page.summary ?? "", page.metadata ?? "", ...page.searchTerms].join('\n');
+    // A bilingual object explicitly named in the primary question is a
+    // constraint, not an optional keyword supplied by extraction.
+    const namedObjects = [...question.matchAll(/([A-Za-z]+(?:-[A-Za-z]+)+)\s*[（(][\u3400-\u9fff]/g)]
+      .map((m) => m[1].toLowerCase().replaceAll('-', '').replace(/s$/, ''));
+    const compact = text.toLowerCase().replace(/[^a-z]/g, '');
+    if (namedObjects.some((name) => !compact.includes(name))) {
+      return { eligible: false, reason: 'explicit_object_mismatch', anchors: namedObjects };
+    }
+    const signatures = wikiErrorSignatures(question);
+    const pageSignatures = wikiErrorSignatures(text);
+    if (signatures.length && pageSignatures.length && !signatures.some((s) => pageSignatures.includes(s))) {
+      return { eligible: false, reason: 'conflicting_error_signature', anchors: [] };
+    }
+    const technical = technicalAnchors(question).filter((anchor) => text.includes(anchor));
+    if (technical.length) return { eligible: true, reason: 'exact_technical_anchor', anchors: technical };
+    const q = ' ' + normalize(question) + ' ';
+    const phrases = [page.title, ...page.searchTerms].filter((p) => phraseHasContent(p) && q.includes(' ' + normalize(p) + ' '));
+    if (phrases.length) return { eligible: true, reason: 'whole_business_phrase', anchors: phrases };
+    if (phraseHasContent(question) && (' ' + normalize(text) + ' ').includes(q)) {
+      return { eligible: true, reason: 'whole_primary_question', anchors: [question] };
+    }
+    const available = new Set(effective(text));
+    const matched = effective(question).filter((term) => available.has(term));
+    const distinct = nonoverlapping(matched, question);
+    const rare = distinct.filter((term) => (dfs.get(term) ?? 0) <= rareMax && !/(?:error|exception)$/i.test(term) && !/^\d/.test(term));
+    // A literal named business object plus two independent title clues is
+    // a compound business anchor even when each word is common in this corpus.
+    const primaryObjects = new Set((question.toLowerCase().match(/[a-z0-9_]+(?:\.[a-z0-9_]+)*/g) ?? []));
+    const named = (page.objects ?? []).filter((object) => effective(object).length && primaryObjects.has(object.toLowerCase()));
+    const titleTerms = new Set(effective(page.title));
+    const titleClues = nonoverlapping(distinct.filter((term) => !/^\d/.test(term) && titleTerms.has(term)), question);
+    if (named.length && titleClues.length >= 2) {
+      return { eligible: true, reason: 'named_object_and_title_clues', anchors: [...named, ...titleClues] };
+    }
+    const accountIds = [...question.matchAll(/(?:科目|account|GL)\s*(\d{4,6})|\b(\d{4,6})\s*(?:科目|分录)/gi)]
+      .map((m) => m[1] ?? m[2]).filter((id) => new RegExp(`\\b${id}\\b`).test(text));
+    if (accountIds.length && distinct.some((t) => !/^\d/.test(t))) {
+      return { eligible: true, reason: 'typed_account_with_context', anchors: [...accountIds, ...distinct] };
+    }
+    return { eligible: distinct.length >= 2 && rare.length > 0,
+      reason: distinct.length >= 2 && rare.length ? 'combined_primary_clues' : 'insufficient_primary_clues', anchors: distinct };
+  };
+  return { assess, documentCount: pages.length, rareMax, documentFrequency: (term: string) => dfs.get(term) ?? 0 };
+}

+import { redactSupportText } from './support-ticket-analysis.js';
+import { wikiErrorSignatures, wikiMatchCount } from './wiki-evidence.js';
+
+export function hasPrimaryQueryMatch(text: string, terms: string[]): boolean {
+  const clean = redactSupportText(text).trim();
+  const messages = /^\s*-\s+\*\*\[/m.test(clean);
+  return clean.split(messages ? /\n(?=\s*-\s+\*\*\[)/ : /\n\s*\n/).some((part) =>
+    wikiMatchCount(part.replace(/^\s*-\s+\*\*\[[^\n]*?\*\*(?:\([^\n]*?\))?\s*[:：]\s*/, ''), terms) > 0);
+}
+
+// Code anchors belong to the same cited paragraph. They are not search aliases
+// and may never become new facts about the current question.
+export function linkedPrimaryAnchors(content: string, sourcePath: string, sourceText: string, question: string): string[] {
+  const body = content.replace(/^---\r?\n[\s\S]*?\r?\n---(?:\r?\n|$)/, '');
+  const signatures = wikiErrorSignatures(question);
+  if (signatures.length && !signatures.some((name) => wikiErrorSignatures(sourceText).includes(name))) return [];
+  const paragraphs = body.split(/\n(?=\s*[-*]\s)|\n\s*\n/).filter((part) => part.includes(sourcePath));
+  return [...new Set(paragraphs.flatMap((part) => [...part.matchAll(/`([^`\n]{4,240})`/g)].map((m) => m[1])))]
+    .filter((anchor) => /\b[A-Za-z]\w*(?:Error|Exception):\s+\S.{3,}/.test(anchor)
+      || /^_?[A-Za-z]\w*_[A-Za-z][\w.]*$/.test(anchor))
+    .filter((anchor) => sourceText.includes(anchor));
+}
